APP_ENV=development

# Prefer the Supabase Session pooler connection string for local development if your network
# does not support IPv6. Copy it from Supabase Dashboard -> Connect.
# Example:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@db.example.supabase.co:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Non-secret defaults live in config/base.env and config/<APP_ENV>.env.
# Put deploy-specific overrides here only when they differ from the tracked config.

# Docker Compose host path for the local Nayiri Western Armenian corpus.
# Containers always read it at /resources/nayiri-western-corpus.
NAYIRI_WESTERN_CORPUS_HOST_PATH=../nayiri-corpus-of-western-armenian-2026-02-25-v2