LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

SUPABASE_AUTH_TIMEOUT_SECONDS=5
SUPABASE_AUTH_CACHE_TTL_SECONDS=60
SUPABASE_BUCKET_BOOK_ORIGINALS=book-originals
SUPABASE_BUCKET_PAGE_IMAGES=page-images
SUPABASE_BUCKET_OCR_JSON=ocr-json

TESSERACT_LANG=hye-calfa-n
OCR_DPI=300
MAX_UPLOAD_MB=100

REFERENCE_IMPORT_MAX_LINE_LENGTH=120
REFERENCE_PDF_TEXT_MIN_LENGTH=40
REFERENCE_FUZZY_THRESHOLD_DEFAULT=90

EXTERNAL_LOOKUP_ENABLED=true
EXTERNAL_LOOKUP_CACHE_TTL_HOURS=24
EXTERNAL_LOOKUP_HTTP_TIMEOUT_SECONDS=10
NAYIRI_PROVIDER_ENABLED=true
NAYIRI_PROVIDER_BASE_URL=http://www.nayiri.com/search
NAYIRI_PROVIDER_RATE_LIMIT_MS=500

PIE_ENABLED=true
PIE_EXECUTABLE=pie
PIE_MODEL_KEY=xcl
PIE_BATCH_SIZE=8
PIE_MAX_TOKENS_PER_BATCH=256
PIE_RUN_ONLY_FOR_CLASSICAL=true
