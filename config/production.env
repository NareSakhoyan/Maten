APP_ENV=production
LOG_LEVEL=INFO

# Keep production CORS explicit in the real environment or .env.
CORS_ALLOW_ORIGINS=https://taragir.vercel.app
CORS_ALLOW_ORIGIN_REGEX=

# Set production Redis URLs in the real environment or .env.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
