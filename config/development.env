APP_ENV=development
LOG_LEVEL=WARNING
SQL_TIMING_ENABLED=false
SQL_LOG_STATEMENT_MAX_CHARS=160

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://taragir.vercel.app
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

TESSDATA_PREFIX=../data/tessdata
PIE_MODEL_ROOT=../data/pie/xcl
PIE_CLASSICAL_MODEL_PATH=../data/pie/xcl
PIE_EASTERN_MODEL_PATH=../data/pie/eastern
